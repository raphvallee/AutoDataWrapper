{
  "name": "autodatawrapper_backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "test:vitest": "node node_modules/vitest/vitest.mjs run",
    "test:vitest:coverage": "node node_modules/vitest/vitest.mjs run --coverage",
    "test:live": "LIVE_SCRAPER=1 bun test --isolate test/live-scraper.test.ts",
    "record:fixtures": "bun run scripts/record-scraper-pages.ts",
    "sync:db": "bun run scripts/sync-db.ts",
    "fix:assisting-systems": "bun run scripts/fix-assisting-systems.ts",
    "smoke:sqlite": "bun scripts/smoke-sqlite.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "puppeteer": "^24.39.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "private": true
}
